# QuantumSpark Pro — Environment Variables
# Copy this file to .env.local for local development.
# Set these variables in Vercel → Project → Settings → Environment Variables for production.

# GitHub personal access token used by the GitHub scanner to call the GitHub API.
# Required scopes: repo (read), workflow (read)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: override the app version shown in the health-check response.
# Defaults to the version field in package.json.
# npm_package_version is injected automatically by npm at runtime;
# only set this if you need to override it.
# NEXT_PUBLIC_APP_VERSION=1.0.0
